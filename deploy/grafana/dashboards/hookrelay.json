      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "In flight per worker",
      "description": "One line per worker replica. Both busy means SKIP LOCKED is spreading the work.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
